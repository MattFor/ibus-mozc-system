#!/usr/bin/env python3

import ctypes
import os
import select
import sys
import time


def env_number(names, default):
	for name in names:
		try:
			return float(os.environ[name])
		except (KeyError, ValueError):
			continue
	return default


HEIGHT_MAX = int(env_number(["IBUS_TIDY_HEIGHT_MAX"], 60))

SWEEP = max(0.1, env_number(["IBUS_TIDY_SWEEP", "IBUS_TIDY_POLL"], 2.0))

DISABLED = os.path.expanduser("~/.config/ibus-candidate-tidy.disabled")

OFFSCREEN = (-10000, -10000)
PARKED_X = -1000  # Anything left of this is from this program or already hidden

VERBOSE = "--verbose" in sys.argv

MapNotify, UnmapNotify, DestroyNotify, ConfigureNotify = 19, 18, 17, 22
SubstructureNotifyMask = 1 << 19
IsViewable = 2

x11 = ctypes.CDLL("libX11.so.6")
Display, Window = ctypes.c_void_p, ctypes.c_ulong


class XWA(ctypes.Structure):
	_fields_ = [
		("x", ctypes.c_int),
		("y", ctypes.c_int),
		("width", ctypes.c_int),
		("height", ctypes.c_int),
		("border_width", ctypes.c_int),
		("depth", ctypes.c_int),
		("visual", ctypes.c_void_p),
		("root", Window),
		("class_", ctypes.c_int),
		("bit_gravity", ctypes.c_int),
		("win_gravity", ctypes.c_int),
		("backing_store", ctypes.c_int),
		("backing_planes", ctypes.c_ulong),
		("backing_pixel", ctypes.c_ulong),
		("save_under", ctypes.c_int),
		("colormap", ctypes.c_ulong),
		("map_installed", ctypes.c_int),
		("map_state", ctypes.c_int),
		("all_event_masks", ctypes.c_long),
		("your_event_mask", ctypes.c_long),
		("do_not_propagate_mask", ctypes.c_long),
		("override_redirect", ctypes.c_int),
		("screen", ctypes.c_void_p),
	]


class XClassHint(ctypes.Structure):
	_fields_ = [("res_name", ctypes.c_void_p), ("res_class", ctypes.c_void_p)]


class XAnyEvent(ctypes.Structure):
	_fields_ = [
		("type", ctypes.c_int),
		("serial", ctypes.c_ulong),
		("send_event", ctypes.c_int),
		("display", Display),
		("window", Window),
	]


class XConfigureEvent(ctypes.Structure):
	_fields_ = [
		("type", ctypes.c_int),
		("serial", ctypes.c_ulong),
		("send_event", ctypes.c_int),
		("display", Display),
		("event", Window),
		("window", Window),
		("x", ctypes.c_int),
		("y", ctypes.c_int),
		("width", ctypes.c_int),
		("height", ctypes.c_int),
		("border_width", ctypes.c_int),
		("above", Window),
		("override_redirect", ctypes.c_int),
	]


class XMapEvent(ctypes.Structure):
	_fields_ = [
		("type", ctypes.c_int),
		("serial", ctypes.c_ulong),
		("send_event", ctypes.c_int),
		("display", Display),
		("event", Window),
		("window", Window),
		("override_redirect", ctypes.c_int),
	]


class XDestroyWindowEvent(ctypes.Structure):
	_fields_ = [
		("type", ctypes.c_int),
		("serial", ctypes.c_ulong),
		("send_event", ctypes.c_int),
		("display", Display),
		("event", Window),
		("window", Window),
	]


class XEvent(ctypes.Union):
	_fields_ = [
		("type", ctypes.c_int),
		("any", XAnyEvent),
		("configure", XConfigureEvent),
		("map", XMapEvent),
		("destroy", XDestroyWindowEvent),
		("pad", ctypes.c_long * 24),
	]


ERRH = ctypes.CFUNCTYPE(ctypes.c_int, Display, ctypes.c_void_p)
x11.XOpenDisplay.restype, x11.XOpenDisplay.argtypes = Display, [ctypes.c_char_p]
x11.XDefaultRootWindow.restype, x11.XDefaultRootWindow.argtypes = Window, [Display]
x11.XQueryTree.argtypes = [
	Display,
	Window,
	ctypes.POINTER(Window),
	ctypes.POINTER(Window),
	ctypes.POINTER(ctypes.POINTER(Window)),
	ctypes.POINTER(ctypes.c_uint),
]
x11.XGetWindowAttributes.argtypes = [Display, Window, ctypes.POINTER(XWA)]
x11.XGetClassHint.argtypes = [Display, Window, ctypes.POINTER(XClassHint)]
x11.XMoveWindow.argtypes = [Display, Window, ctypes.c_int, ctypes.c_int]
x11.XSelectInput.argtypes = [Display, Window, ctypes.c_long]
x11.XNextEvent.argtypes = [Display, ctypes.POINTER(XEvent)]
x11.XPending.restype, x11.XPending.argtypes = ctypes.c_int, [Display]
x11.XConnectionNumber.restype, x11.XConnectionNumber.argtypes = ctypes.c_int, [Display]
x11.XFlush.argtypes = [Display]
x11.XFree.argtypes = [ctypes.c_void_p]
x11.XSetErrorHandler.restype = ctypes.c_void_p
x11.XSetErrorHandler.argtypes = [ERRH]

# The candidate window is destroyed and recreated freely
_keep = ERRH(lambda d, e: 0)
x11.XSetErrorHandler(_keep)

dpy = x11.XOpenDisplay(None)
if not dpy:
	sys.stderr.write("ibus-candidate-tidy: cannot open display\n")
	sys.exit(2)

root = x11.XDefaultRootWindow(dpy)


def log(msg):
	if VERBOSE:
		print(f"ibus-candidate-tidy: {msg}", flush=True)


def attrs(win):
	a = XWA()
	if not x11.XGetWindowAttributes(dpy, win, ctypes.byref(a)):
		return None

	return a


def is_ibus_panel(win):
	ch = XClassHint()

	if not x11.XGetClassHint(dpy, win, ctypes.byref(ch)):
		return False

	try:
		name = ctypes.string_at(ch.res_name).decode(errors="replace") if ch.res_name else ""
		cls = ctypes.string_at(ch.res_class).decode(errors="replace") if ch.res_class else ""
	finally:
		for ptr in (ch.res_name, ch.res_class):
			if ptr:
				x11.XFree(ptr)

	return "ibus-ui-gtk3" in name.lower() or "ibus-ui-gtk3" in cls.lower()


_known = {}


def is_candidate(win):
	hit = _known.get(win)
	if hit is None:
		a = attrs(win)
		if not a:
			return False  # gone, or not readable yet; decide on its next event rather than never
		hit = bool(a.override_redirect and is_ibus_panel(win))
		_known[win] = hit

	return hit


_home = {}


def consider(win, x, y, height):
	if not is_candidate(win):
		return

	if height >= HEIGHT_MAX:
		if x <= PARKED_X:
			home = _home.get(win)
			if home:
				x11.XMoveWindow(dpy, win, home[0], home[1])
				x11.XFlush(dpy)
				log(f"restored 0x{win:08x} to {home[0]},{home[1]} ({height}px of candidates)")
		else:
			_home[win] = (x, y)
		return

	# Empty box
	if x > PARKED_X:
		_home[win] = (x, y)
		x11.XMoveWindow(dpy, win, *OFFSCREEN)
		x11.XFlush(dpy)
		log(f"parked leftover {height}px window 0x{win:08x} from {x},{y}")


def sweep():
	r, p = Window(), Window()
	kids = ctypes.POINTER(Window)()
	n = ctypes.c_uint()

	if not x11.XQueryTree(dpy, root, ctypes.byref(r), ctypes.byref(p), ctypes.byref(kids), ctypes.byref(n)):
		return

	for i in range(n.value):
		w = kids[i]
		a = attrs(w)
		if a and a.map_state == IsViewable and a.override_redirect:
			consider(w, a.x, a.y, a.height)

	if kids:
		x11.XFree(kids)


x11.XSelectInput(dpy, root, SubstructureNotifyMask)
x11.XFlush(dpy)
sweep()

log(f"started (height_max={HEIGHT_MAX} sweep={SWEEP}s, event-driven)")

fd = x11.XConnectionNumber(dpy)
event = XEvent()
checked = time.monotonic()

while True:
	# Drain everything queued before going back to sleep
	while x11.XPending(dpy) > 0:
		x11.XNextEvent(dpy, ctypes.byref(event))
		kind = event.type

		if kind == ConfigureNotify:
			c = event.configure
			consider(c.window, c.x, c.y, c.height)
		elif kind == MapNotify:
			w = event.map.window
			a = attrs(w)
			if a:
				consider(w, a.x, a.y, a.height)
		elif kind == DestroyNotify:
			w = event.destroy.window
			_known.pop(w, None)
			_home.pop(w, None)

	try:
		select.select([fd], [], [], SWEEP)
	except (OSError, select.error):
		continue

	# Checked on the clock, not only when idle: a busy desktop may never go quiet for a whole sweep.
	if time.monotonic() - checked >= SWEEP:
		checked = time.monotonic()
		if os.path.exists(DISABLED):
			log(f"{DISABLED} exists; stopping")
			sys.exit(0)

	if x11.XPending(dpy) == 0:
		sweep()
