#!/bin/sh

ENGINE=mozc-jp
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}"
LOG="$STATE_DIR/ibus-mozc-init.log"
XIM_LOG="$STATE_DIR/ibus-x11.log"
DAEMON_LOG="$STATE_DIR/ibus-daemon.log"
TIDY_OFF="$HOME/.config/ibus-candidate-tidy.disabled"
UID_="$(id -u)"

# The same directory kana-switch uses; a shared /tmp name could be taken by another user.
if [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -d "$XDG_RUNTIME_DIR" ]; then
    RUNTIME="$XDG_RUNTIME_DIR"
else
    RUNTIME="/tmp/kana-switch-$UID_"
    mkdir -m 700 "$RUNTIME" 2>/dev/null
    if [ -L "$RUNTIME" ] || [ ! -O "$RUNTIME" ]; then
        echo "ibus-mozc-init: $RUNTIME is not a directory of this user; set XDG_RUNTIME_DIR" >&2
        exit 1
    fi
fi
LOCK="$RUNTIME/ibus-mozc-init.lock"
FOLLOW_LOCK="$RUNTIME/mozc-kana-state.follow.lock"

BUS_WAIT=60         # Seconds to wait for the ibus daemon to answer at all
ACTIVATE_WAIT=90    # Seconds to keep trying to select the engine
CALL_TIMEOUT=5      # Seconds any single ibus call may block
HEALTH_TIMEOUT=30   # Seconds the deep probe may take; XOpenIM() can block on a hung server
LOGIN_PHASE=300     # Seconds of fast polling after login
FAST_INTERVAL=5     # Poll period during the login phase
SLOW_INTERVAL=15    # Poll period for the rest of the session
DEEP_EVERY=300      # Seconds between full ibus-health probes
MAX_SESSION_FIXES=3 # Daemon restarts allowed to claim the session bus name

WATCH=0
[ "$1" = "--watch" ] && WATCH=1

# Where's ibus-x11?
XIM_BIN=""
for candidate in \
    "$IBUS_X11_BIN" \
    /usr/libexec/ibus-x11 \
    /usr/lib/ibus/ibus-x11 \
    /usr/lib64/ibus/ibus-x11 \
    /usr/lib/x86_64-linux-gnu/ibus/ibus-x11 \
    /usr/local/libexec/ibus-x11; do
    [ -n "$candidate" ] && [ -x "$candidate" ] && {
        XIM_BIN="$candidate"
        break
    }
done

# Next to this copy first: the session PATH need not contain ~/.local/bin.
sibling() {
    found="$(dirname "$0")/$1"
    [ -x "$found" ] || found="$(command -v "$1" 2>/dev/null)"
    printf '%s\n' "$found"
}

TIDY_BIN="$(sibling ibus-candidate-tidy)"
SWITCH_BIN="$(sibling kana-switch)"
HEALTH_BIN="$(sibling ibus-health)"

mkdir -p "$STATE_DIR" 2>/dev/null

log() {
    # stdout is /dev/null under xfce4-session, so log to $LOG and stderr.
    printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >>"$LOG"
    printf 'ibus-mozc-init: %s\n' "$*" >&2
}

now() { date +%s; }

# Truncate in place, never rename: ibus-x11 holds $XIM_LOG open for the whole session and would keep appending to an unlinked inode.
trim_log() {
    [ -f "$1" ] || return 0
    [ "$(wc -l <"$1" 2>/dev/null || echo 0)" -gt "$2" ] || return 0
    tmp="$1.trim.$$"

    if tail -n "$3" "$1" >"$tmp" 2>/dev/null; then
        cat "$tmp" >"$1" 2>/dev/null
    fi

    rm -f "$tmp"
}

trim_log "$LOG" 2000 500
trim_log "$XIM_LOG" 2000 500

# One watcher at a time.
if [ "$WATCH" = 1 ]; then
    exec 9>"$LOCK" || exit 1
    if ! flock -n 9; then
        log "another watcher is already running; nothing to do"
        exit 0
    fi
fi

running() { pgrep -u "$UID_" -x "$1" >/dev/null 2>&1; }

engine_now() { timeout "$CALL_TIMEOUT" ibus engine 2>/dev/null; }
set_engine() { timeout "$CALL_TIMEOUT" ibus engine "$ENGINE" >/dev/null 2>&1; }

x_alive() { xset q >/dev/null 2>&1; }

context() {
    command -v xdotool >/dev/null 2>&1 || return 0
    printf 'focus=%s' "$(timeout 2 xdotool getactivewindow getwindowname 2>/dev/null || echo '?')"
}

apply_xmodmap() {
    [ -f "$HOME/.Xmodmap" ] || return 0
    xmodmap "$HOME/.Xmodmap" 2>/dev/null

    [ -n "$SWITCH_BIN" ] && [ -x "$SWITCH_BIN" ] && "$SWITCH_BIN" norepeat >/dev/null 2>&1

    return 0
}

xmodmap_dropped() {
    [ -f "$HOME/.Xmodmap" ] || return 1
    xmodmap -pke 2>/dev/null | awk '
        src == "want" { if ($1 == "keycode" && $3 == "=") want[$2] = $4; next }
        $1 == "keycode" && ($2 in want) && $4 == want[$2] { ok[$2] = 1 }
        END { for (k in want) if (!(k in ok)) exit 0; exit 1 }
    ' src=want "$HOME/.Xmodmap" src=live -
}

# 9>&- throughout
start_xim() {
    if [ -z "$XIM_BIN" ]; then
        log "WARNING: no ibus-x11 binary found; set IBUS_X11_BIN to its path"
        return 1
    fi

    # Never --kill-daemon cause that makes ibus-x11's exit tear down the daemon, turning the next XIM crash into a total outage.
    setsid nohup "$XIM_BIN" >>"$XIM_LOG" 2>&1 </dev/null 9>&- &
    sleep 1
}

ensure_tidy() {
    [ -n "$TIDY_BIN" ] && [ -x "$TIDY_BIN" ] || return 0
    [ -f "$TIDY_OFF" ] && return 0

    # Its process name is python3; match the script name wherever it was started from.
    pgrep -u "$UID_" -f '(^|/)python[0-9.]* ([^ ]*/)?ibus-candidate-tidy( |$)' >/dev/null 2>&1 && return 0
    setsid nohup "$TIDY_BIN" >/dev/null 2>&1 </dev/null 9>&- &

    log "started ibus-candidate-tidy"
}

# kana-switch follow mirrors Mozc's real mode into the state file and keeps it across a rebuilt engine.
ensure_follow() {
    [ -n "$SWITCH_BIN" ] && [ -x "$SWITCH_BIN" ] || return 0
    command -v dbus-monitor >/dev/null 2>&1 || return 0

    # A running follower holds this lock exclusively for its whole life; probe it shared, as everything else does.
    flock -s -n "$FOLLOW_LOCK" true 2>/dev/null || return 0
    setsid nohup "$SWITCH_BIN" follow >/dev/null 2>>"$LOG" </dev/null 9>&- &

    log "started kana-switch follow"
}

ensure_xim() {
    running ibus-x11 && return 0
    log "XIM server (ibus-x11) is gone -- restarting it; see $XIM_LOG"

    start_xim

    if running ibus-x11; then
        log "XIM server restarted"
    else
        log "WARNING: XIM server failed to restart"
    fi
}

start_daemon() {
    ibus-daemon -drR >>"$DAEMON_LOG" 2>&1 9>&-
}

session_name_owned() {
    [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ] || return 1
    command -v gdbus >/dev/null 2>&1 || return 0 # Cannot tell; do not thrash

    timeout "$CALL_TIMEOUT" gdbus call --session \
        --dest org.freedesktop.DBus \
        --object-path /org/freedesktop/DBus \
        --method org.freedesktop.DBus.GetNameOwner \
        org.freedesktop.IBus >/dev/null 2>&1
}

ensure_session_bus() {
    running ibus-daemon || return 0
    session_name_owned && return 0

    if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
        log "WARNING: no DBUS_SESSION_BUS_ADDRESS in this process, so a daemon"
        log "         started without the session bus cannot be repaired from"
        log "         here. GTK4 applications will get no input."
        return 1
    fi

    session_fixes=$((session_fixes + 1))
    if [ "$session_fixes" -gt "$MAX_SESSION_FIXES" ]; then
        [ "$session_fixes" -eq $((MAX_SESSION_FIXES + 1)) ] \
            && log "giving up on the session bus name after $MAX_SESSION_FIXES restarts"
        return 1
    fi

    log "ibus-daemon does not own org.freedesktop.IBus on the session bus"
    log "  -- GTK4 applications get no keys at all -- restarting it (fix #$session_fixes)"

    pkill -u "$UID_" -x ibus-daemon 2>/dev/null
    sleep 2
    start_daemon
    sleep 3

    if session_name_owned; then
        log "session bus name claimed; GTK4 input works again"
    else
        log "WARNING: org.freedesktop.IBus still has no owner on the session bus"
    fi
}

log "Start (watch=$WATCH)"
[ -n "$XIM_BIN" ] || log "WARNING: ibus-x11 not found in any known location"

session_fixes=0

# 1. Daemon must exist.
if ! running ibus-daemon; then
    log "no ibus-daemon, starting one"
    start_daemon
    sleep 2
fi

# 1b. A daemon that predates the session bus has to be replaced, not adopted.
ensure_session_bus

# 2. Wait for the bus.
deadline=$(($(now) + BUS_WAIT))
while :; do
    timeout "$CALL_TIMEOUT" ibus list-engine >/dev/null 2>&1 && break
    if [ "$(now)" -ge "$deadline" ]; then
        log "FAILED: bus never answered in ${BUS_WAIT}s; giving up"
        exit 1
    fi
    sleep 1
done

log "bus answered"

# 3. Select Mozc.
deadline=$(($(now) + ACTIVATE_WAIT))
while [ "$(engine_now)" != "$ENGINE" ]; do
    set_engine
    if [ "$(now)" -ge "$deadline" ]; then
        log "FAILED to activate $ENGINE in ${ACTIVATE_WAIT}s (engine is '$(engine_now)')"
        apply_xmodmap
        exit 1
    fi
    sleep 1
done
log "active engine: $ENGINE"

ensure_xim
ensure_tidy
apply_xmodmap

[ "$WATCH" = 1 ] || exit 0

ensure_follow

log "supervising: engine + XIM, ${FAST_INTERVAL}s for the first ${LOGIN_PHASE}s then ${SLOW_INTERVAL}s"

elapsed=0
since_deep=0
engine_fixes=0
xim_fixes=0
daemon_fixes=0

while :; do
    if [ "$elapsed" -lt "$LOGIN_PHASE" ]; then
        interval="$FAST_INTERVAL"
    else
        interval="$SLOW_INTERVAL"
    fi

    sleep "$interval" 9>&-
    elapsed=$((elapsed + interval))
    since_deep=$((since_deep + interval))

    # The session is over when the X server goes.
    if ! x_alive; then
        log "X server gone after ${elapsed}s ($engine_fixes engine / $xim_fixes XIM repair(s)); exiting"
        exit 0
    fi

    # The daemon must come back first; the checks below cannot work without it.
    if ! running ibus-daemon; then
        daemon_fixes=$((daemon_fixes + 1))
        log "ibus-daemon itself is gone at ${elapsed}s (repair #$daemon_fixes) [$(context)], restarting"
        start_daemon
        sleep 3
    fi

    # One failed call is not a cleared engine; ask twice before repairing.
    if [ "$(engine_now)" != "$ENGINE" ] && sleep 1 9>&- && [ "$(engine_now)" != "$ENGINE" ]; then
        engine_fixes=$((engine_fixes + 1))
        log "global engine was cleared at ${elapsed}s (repair #$engine_fixes) [$(context)], re-setting $ENGINE"
        set_engine
    fi

    if ! running ibus-x11; then
        xim_fixes=$((xim_fixes + 1))
        log "XIM server died at ${elapsed}s (repair #$xim_fixes) [$(context)]"
        ensure_xim
    fi

    ensure_tidy
    ensure_follow

    if xmodmap_dropped; then
        [ "$elapsed" -gt "$LOGIN_PHASE" ] && log "~/.Xmodmap was dropped at ${elapsed}s (layout re-asserted?); re-applying"
        apply_xmodmap
    fi

    # Catches an ibus-x11 that is alive but no longer owns the @server=ibus selection, which pgrep cannot see.
    if [ "$since_deep" -ge "$DEEP_EVERY" ]; then
        since_deep=0
        trim_log "$LOG" 2000 500
        trim_log "$XIM_LOG" 2000 500
        ensure_session_bus
        # --xim: only the XIM checks decide this, so a fault a restart cannot fix does not restart XIM forever.
        if [ -n "$HEALTH_BIN" ] && [ -x "$HEALTH_BIN" ] && ! timeout "$HEALTH_TIMEOUT" "$HEALTH_BIN" --quiet --xim 9>&-; then
            log "deep probe failed while the cheap checks passed, restarting XIM server"
            pkill -u "$UID_" -x ibus-x11 2>/dev/null
            sleep 1
            start_xim
            xim_fixes=$((xim_fixes + 1))
            if timeout "$HEALTH_TIMEOUT" "$HEALTH_BIN" --quiet --xim 9>&-; then
                log "deep probe healthy again"
            else
                log "WARNING: still unhealthy after XIM restart"
            fi
        fi
    fi
done
