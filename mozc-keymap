#!/usr/bin/env python3

import os
import shutil
import socket
import struct
import subprocess
import sys
import time
from typing import NoReturn

HOME = os.path.expanduser("~")
PROFILE = (
	os.path.join(HOME, ".mozc")
	if os.path.isdir(os.path.join(HOME, ".mozc"))
	else os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config"), "mozc")
)
CONFIG = os.path.join(PROFILE, "config1.db")
IPC_INFO = os.path.join(PROFILE, ".session.ipc")

KEYMAP_FIELD = 42  # Config.custom_keymap_table (TSV string)
SELECT_FIELD = 41  # Config.session_keymap
SELECT_CUSTOM = 0  # SessionKeymap.CUSTOM
HEADER = "status\tkey\tcommand"

SET_CONFIG = 7  # commands.Input.CommandType
INPUT_TYPE, INPUT_CONFIG = 1, 5  # commands.Input fields
OUTPUT_CONFIG, OUTPUT_ERROR = 9, 11  # commands.Output fields

WIRE_VARINT, WIRE_64, WIRE_BYTES, WIRE_32 = 0, 1, 2, 5


def die(msg: str) -> NoReturn:
	print(f"mozc-keymap: {msg}", file=sys.stderr)
	sys.exit(1)


def read_varint(buf, pos):
	result = shift = 0
	while True:
		if pos >= len(buf):
			raise ValueError("truncated varint")

		byte = buf[pos]
		result |= (byte & 0x7F) << shift
		pos += 1
		shift += 7

		if not byte & 0x80:
			return result, pos


def write_varint(value):
	out = bytearray()
	while True:
		byte = value & 0x7F
		value >>= 7
		out.append(byte | (0x80 if value else 0))

		if not value:
			return bytes(out)


def take(buf, pos, size):
	if pos + size > len(buf):
		raise ValueError("truncated field")
	return buf[pos : pos + size], pos + size


def parse(buf):
	"""[(field_number, wire_type, raw_value_bytes)] in file order."""
	fields, pos = [], 0
	while pos < len(buf):
		tag, pos = read_varint(buf, pos)
		number, wire = tag >> 3, tag & 7
		if wire == WIRE_VARINT:
			start = pos
			_, pos = read_varint(buf, pos)
			value = buf[start:pos]
		elif wire == WIRE_64:
			value, pos = take(buf, pos, 8)
		elif wire == WIRE_BYTES:
			length, pos = read_varint(buf, pos)
			value, pos = take(buf, pos, length)
		elif wire == WIRE_32:
			value, pos = take(buf, pos, 4)
		else:
			raise ValueError(f"unsupported wire type {wire} for field {number}")

		fields.append((number, wire, value))

	return fields


def serialise(fields):
	out = bytearray()
	for number, wire, value in fields:
		out += write_varint(number << 3 | wire)

		if wire == WIRE_BYTES:
			out += write_varint(len(value))

		out += value

	return bytes(out)


def load_config(missing_ok=False):
	try:
		with open(CONFIG, "rb") as fh:
			raw = fh.read()
	except FileNotFoundError:
		if missing_ok:
			return b"", []  # Mozc writes no file until its settings are first saved
		die(f"{CONFIG} does not exist; Mozc is running on its defaults")
	except OSError as e:
		die(f"cannot read {CONFIG}: {e}")

	try:
		return raw, parse(raw)
	except ValueError as e:
		die(f"{CONFIG} is not a config protobuf this tool understands ({e})")


def current_table(fields):
	for number, wire, value in fields:
		if number == KEYMAP_FIELD and wire == WIRE_BYTES:
			return value.decode("utf-8", "replace")

	return None


def read_text(path):
	try:
		with open(path, encoding="utf-8") as fh:
			return fh.read()
	except (OSError, UnicodeDecodeError) as e:
		die(f"cannot read {path}: {e}")


def check(text, source):
	rows = [ln for ln in text.split("\n") if ln.strip()]
	if not rows or rows[0].strip() != HEADER:
		die(f"{source}: first line must be the header {HEADER!r}")

	seen = {}

	for n, row in enumerate(rows[1:], start=2):
		parts = row.split("\t")

		if len(parts) != 3:
			die(f"{source}:{n}: expected 3 tab-separated columns, got {len(parts)}")
		state, key, command = (p.strip() for p in parts)

		if not (state and key and command):
			die(f"{source}:{n}: empty column")

		# Mozc silently keeps the last binding for a repeated (state, key).
		if (state, key) in seen:
			die(
				f"{source}:{n}: {state}\t{key} is already bound on line {seen[(state, key)]}; Mozc would silently keep only the last one"
			)

		seen[(state, key)] = n

	return rows


def server_call(request):
	"""Send one request to this user's mozc_server; its reply, or None if it cannot be reached."""
	try:
		with open(IPC_INFO, "rb") as fh:
			info = parse(fh.read())
	except (OSError, ValueError):
		return None

	key = next((v.decode("ascii", "replace") for n, w, v in info if n == 1 and w == WIRE_BYTES), "")
	if not key:
		return None

	# Mozc's path "/tmp/.mozc.<key>.session", its first byte replaced by NUL: an abstract socket.
	address = b"\0tmp/.mozc." + key.encode() + b".session"
	try:
		with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
			sock.settimeout(5)
			sock.connect(address)
			_pid, uid, _gid = struct.unpack("3i", sock.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12))
			if uid != os.getuid():
				return None

			sock.sendall(request)
			sock.shutdown(socket.SHUT_WR)  # the server reads to EOF before answering
			reply = b""
			while chunk := sock.recv(65536):
				reply += chunk
	except OSError:
		return None

	return reply


def set_config_live(config_bytes):
	"""Hand a whole config to the running server, as Mozc's settings dialog does."""
	request = (
		write_varint(INPUT_TYPE << 3 | WIRE_VARINT)
		+ write_varint(SET_CONFIG)
		+ write_varint(INPUT_CONFIG << 3 | WIRE_BYTES)
		+ write_varint(len(config_bytes))
		+ config_bytes
	)
	reply = server_call(request)
	if not reply:
		return False

	try:
		fields = parse(reply)
	except ValueError:
		return False

	errors = [read_varint(v, 0)[0] for n, w, v in fields if n == OUTPUT_ERROR and w == WIRE_VARINT]
	# SetConfig echoes the config back; SESSION_SUCCESS is 0.
	return any(n == OUTPUT_CONFIG for n, _w, _v in fields) and not any(errors)


def write_config(out):
	os.makedirs(PROFILE, mode=0o700, exist_ok=True)
	tmp = f"{CONFIG}.new-{os.getpid()}"
	with open(tmp, "wb") as fh:
		fh.write(out)
		fh.flush()
		os.fsync(fh.fileno())

	if os.path.exists(CONFIG):
		shutil.copystat(CONFIG, tmp)
	os.replace(tmp, CONFIG)


def restart_server():
	# mozc_server caches the config at startup; the client relaunches it on the next keystroke.
	subprocess.run(["pkill", "-u", str(os.getuid()), "-x", "mozc_server"], check=False)
	time.sleep(0.5)
	print("mozc-keymap: mozc_server stopped; it restarts on the next keystroke")


def cmd_show(argv):
	_raw, fields = load_config()
	table = current_table(fields)

	if table is None:
		die("no custom keymap is stored; Mozc is using a built-in preset")

	sys.stdout.write(table if table.endswith("\n") else table + "\n")

	return 0


def cmd_diff(argv):
	if not argv:
		die("usage: mozc-keymap diff FILE")

	want = read_text(argv[0]).split("\n")
	_raw, fields = load_config(missing_ok=True)
	live = (current_table(fields) or "").split("\n")
	live = [ln for ln in live if ln.strip()]
	want = [ln for ln in want if ln.strip()]
	live_set, want_set = set(live), set(want)
	removed = [ln for ln in live if ln not in want_set]
	added = [ln for ln in want if ln not in live_set]

	for ln in removed:
		print(f"-{ln}")

	for ln in added:
		print(f"+{ln}")

	if not removed and not added:
		print("identical")
		return 0

	return 1


def cmd_apply(argv):
	files = [a for a in argv if not a.startswith("-")]
	restart = "--restart" in argv

	if not files:
		die("usage: mozc-keymap apply FILE [--restart]")

	text = read_text(files[0])
	check(text, files[0])
	if not text.endswith("\n"):
		text += "\n"

	raw, fields = load_config(missing_ok=True)

	rebuilt, saw_keymap, saw_select = [], False, False
	for number, wire, value in fields:
		if number == KEYMAP_FIELD and wire == WIRE_BYTES:
			rebuilt.append((number, wire, text.encode()))
			saw_keymap = True
		elif number == SELECT_FIELD and wire == WIRE_VARINT:
			rebuilt.append((number, wire, write_varint(SELECT_CUSTOM)))
			saw_select = True
		else:
			rebuilt.append((number, wire, value))

	if not saw_select:
		rebuilt.append((SELECT_FIELD, WIRE_VARINT, write_varint(SELECT_CUSTOM)))

	if not saw_keymap:
		rebuilt.append((KEYMAP_FIELD, WIRE_BYTES, text.encode()))

	out = serialise(rebuilt)

	try:
		if current_table(parse(out)) != text:
			raise ValueError("round-trip mismatch")
	except ValueError as e:
		die(f"refusing to write a config that does not round-trip ({e}); {CONFIG} is untouched")

	if raw:
		backup = f"{CONFIG}.bak-{time.strftime('%Y%m%d%H%M%S')}"
		shutil.copy2(CONFIG, backup)
		print(f"mozc-keymap: previous config saved as {backup}")

	write_config(out)

	print(f"mozc-keymap: wrote {len(text.encode())} bytes of keymap to {CONFIG}")
	print(f"mozc-keymap: {'unchanged' if out == raw else 'config changed'}")

	if restart:
		restart_server()
	elif set_config_live(out):
		print("mozc-keymap: mozc_server took the new config; it is in effect now")
	else:
		print("mozc-keymap: mozc_server could not be reached; it reads the new config when it next")
		print("             starts (pkill -x mozc_server, or run this again with --restart)")

	return 0


def cmd_reload(argv):
	raw, _fields = load_config()
	if set_config_live(raw):
		print(f"mozc-keymap: mozc_server now uses {CONFIG}")
		return 0

	die("mozc_server could not be reached (is Mozc running in this session?)")


COMMANDS = {"show": cmd_show, "diff": cmd_diff, "apply": cmd_apply, "reload": cmd_reload}


def main(argv):
	if "--help" in argv or "-h" in argv:
		print(__doc__.strip())
		return 0

	if len(argv) < 2 or argv[1] not in COMMANDS:
		die("usage: mozc-keymap {show | diff FILE | apply FILE [--restart] | reload}")

	return COMMANDS[argv[1]](argv[2:])


if __name__ == "__main__":
	sys.exit(main(sys.argv))
